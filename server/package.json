{
  "name": "igtihad-server",
  "version": "1.0.0",
  "description": "Ijtihad Platform Backend API Server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
